{
  "name": "eureka/component-http",
  "description": "PHP PSR-15 implementation.",
  "type": "library",
  "minimum-stability": "stable",
  "license": "MIT",

  "authors": [
    {
      "name": "Romain Cottard",
      "role": "Developer"
    }
  ],

  "autoload": {
    "psr-4": {
      "Eureka\\Component\\Http\\": "./src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Eureka\\Component\\Http\\Tests\\Unit\\": "./tests/unit",
      "Eureka\\Component\\Http\\Tests\\Integration\\": "./tests/integration"
    }
  },

  "config": {
    "sort-packages": true
  },

  "require": {
    "php": ">=8.3",

    "psr/http-message": "^1.0||^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0"
  },

  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.92.4",
    "phpstan/phpstan": "^2.1.33",
    "phpstan/phpstan-phpunit": "^2.0.11",
    "phpstan/phpstan-strict-rules": "^2.0.7",
    "phpunit/phpcov": "^11.0.3",
    "phpunit/phpunit": "^12.5.4",
    "shipmonk/composer-dependency-analyser": "^1.8.4"
  }
}
